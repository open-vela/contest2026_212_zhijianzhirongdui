COMPOSE_PROJECT_NAME=dominiscius-demo
DOMINISCIUS_IMAGE=dominiscius-demo:0.2.0
APP_VERSION=0.2.0
APP_PORT=8000
APP_UID=1000

DEBUG=false
JWT_SECRET=replace-this-with-a-random-value-at-least-32-chars
SEED_DEFAULT_TENANT=默认组织
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123

MQTT_CLIENT_ID=dominiscius-server
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=vela
DEMO_NODE_ONLINE_SECONDS=15
DEMO_SIMULATION_ENABLED=false

# disabled: queue only; mock: local acknowledgement; http: generic HTTP endpoint
DEMO_CLOUD_MODE=mock
DEMO_CLOUD_ENDPOINT=
DEMO_CLOUD_TIMEOUT_SECONDS=5
DEMO_CLOUD_MAX_RETRIES=5
DEMO_CLOUD_BACKOFF_BASE_SECONDS=1
DEMO_CLOUD_BACKOFF_MAX_SECONDS=60
DEMO_CLOUD_WORKER_INTERVAL_SECONDS=1
