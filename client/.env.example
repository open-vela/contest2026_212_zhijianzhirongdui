# Relative URL works for both Vite's development proxy and the FastAPI static build.
#
# Legacy-name note: the project was renamed from "Dominiscius" to 枢络 VelaMesh.
# This client exposes no brand-derived env vars; legacy identifiers that are kept
# for compatibility (SQLite file, MQTT client id, gait topic root) all live
# server-side — see server/.env.example.
VITE_API_BASE_URL=/api

# Data source: mock | local_mqtt | cloud_api | mixed
# local_mqtt: real FastAPI + SQLite + MQTT evidence (competition default)
# mock: clearly labelled offline rehearsal data; never counted as measured score
VITE_DEMO_MODE=local_mqtt
