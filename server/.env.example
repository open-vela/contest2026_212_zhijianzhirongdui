# 枢络 VelaMesh server — environment template.
# Copy to `.env` and adjust. The server reads .env on startup.
#
# Legacy-name compatibility: this codebase was formerly named "Dominiscius".
# The following identifiers intentionally KEEP the old spelling so existing
# deployments, firmware and data keep working — do not "fix" them:
#   - SQLite data file: data/dominiscius.db (default DATABASE_URL below)
#   - MQTT client id default: dominiscius-server (MQTT_CLIENT_ID)
#   - log file name: dominiscius.log
#   - gait topic root "dominiscius/+/gait/result" — hard-coded in firmware
# Environment variable NAMES are unchanged for the same reason.
#
# MQTT broker MUST be the same broker the ESP32 firmware publishes to.
# The firmware (xiaosense_network.c) defaults to:
#   broker  = 10.6.40.22:1883   (the PC's IP on the board's WiFi network)
#   creds   = vela-node / vela-secret-2026
#   topic   = vela/node/1/face  (NODE_ID=1 by default)
# Set MQTT_BROKER / MQTT_USERNAME / MQTT_PASSWORD to match that broker.

MQTT_BROKER=127.0.0.1
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=vela
# Uncomment and match the firmware broker credentials if it requires auth:
# MQTT_USERNAME=vela-node
# MQTT_PASSWORD=vela-secret-2026

# Optional future cloud receiver. Demo uploads remain in the SQLite outbox
# until a delivery worker is configured; leaving this blank is the safe local
# competition default.
# DEMO_CLOUD_ENDPOINT=https://example.invalid/ingest
DEMO_NODE_ONLINE_SECONDS=15
DEMO_SIMULATION_ENABLED=false

# Cloud outbox transport: disabled | mock | http
DEMO_CLOUD_MODE=disabled
DEMO_CLOUD_TIMEOUT_SECONDS=5
DEMO_CLOUD_MAX_RETRIES=5
DEMO_CLOUD_BACKOFF_BASE_SECONDS=1
DEMO_CLOUD_BACKOFF_MAX_SECONDS=60
DEMO_CLOUD_WORKER_INTERVAL_SECONDS=1

HOST=0.0.0.0
PORT=8000
DEBUG=false
# STATIC_DIR defaults to server/static. A production image copies Vue dist here.
# STATIC_DIR=/app/server/static
# LOG_DIR=/app/server/logs

# Database (sqlite, auto-created in server/data/)
# DATABASE_URL=sqlite+aiosqlite:///./data/dominiscius.db

# JWT secret — change for production
JWT_SECRET=dev-secret-change-in-production-min-32-chars!!

# Default admin (seeded on first run)
SEED_DEFAULT_TENANT=默认组织
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
